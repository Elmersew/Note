generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum EntityType {
  NOTE
  TASK
  EVENT
}

enum ChangeOperation {
  UPSERT
  DELETE
}

model User {
  id           String          @id @default(uuid()) @db.Char(36)
  email        String?         @unique @db.VarChar(191)
  phone        String?         @unique @db.VarChar(32)
  passwordHash String          @map("password_hash") @db.VarChar(191)
  displayName  String          @map("display_name") @db.VarChar(80)
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  notes        Note[]
  tags         Tag[]
  tasks        Task[]
  events       CalendarEvent[]
  changes      ChangeLog[]
  mutations    Mutation[]

  @@map("users")
}

model Note {
  id          String      @id @db.Char(36)
  userId      String      @map("user_id") @db.Char(36)
  title       String      @default("") @db.VarChar(255)
  content     Json
  plainText   String      @map("plain_text") @db.LongText
  isPinned    Boolean     @default(false) @map("is_pinned")
  isArchived  Boolean     @default(false) @map("is_archived")
  version     Int         @default(1)
  deletedAt   DateTime?   @map("deleted_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags        NoteTag[]
  shares      NoteShare[]
  sourceTasks Task[]      @relation("TaskSource")
  sourceEvents CalendarEvent[] @relation("EventSource")

  @@index([userId, deletedAt, isPinned, updatedAt])
  @@fulltext([title, plainText], map: "notes_title_plain_text_fts")
  @@map("notes")
}

model Tag {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @map("user_id") @db.Char(36)
  name      String    @db.VarChar(64)
  color     String    @default("#6d5dfc") @db.VarChar(16)
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes     NoteTag[]

  @@unique([userId, name])
  @@map("tags")
}

model NoteTag {
  noteId String @map("note_id") @db.Char(36)
  tagId  String @map("tag_id") @db.Char(36)
  note   Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId])
  @@map("note_tags")
}

model NoteShare {
  id        String    @id @default(uuid()) @db.Char(36)
  noteId    String    @map("note_id") @db.Char(36)
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime? @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  note      Note      @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId])
  @@map("note_shares")
}

model Task {
  id           String       @id @db.Char(36)
  userId       String       @map("user_id") @db.Char(36)
  title        String       @db.VarChar(255)
  description  String       @default("") @db.Text
  status       TaskStatus   @default(TODO)
  priority     TaskPriority @default(MEDIUM)
  dueAt        DateTime?    @map("due_at")
  sourceNoteId String?      @map("source_note_id") @db.Char(36)
  version      Int          @default(1)
  deletedAt    DateTime?    @map("deleted_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceNote   Note?        @relation("TaskSource", fields: [sourceNoteId], references: [id], onDelete: SetNull)

  @@index([userId, status, dueAt])
  @@map("tasks")
}

model CalendarEvent {
  id           String   @id @db.Char(36)
  userId       String   @map("user_id") @db.Char(36)
  title        String   @db.VarChar(255)
  description  String   @default("") @db.Text
  startsAt     DateTime @map("starts_at")
  endsAt       DateTime @map("ends_at")
  timezone     String   @default("UTC") @db.VarChar(64)
  isAllDay     Boolean  @default(false) @map("is_all_day")
  location     String?  @db.VarChar(255)
  sourceNoteId String?  @map("source_note_id") @db.Char(36)
  version      Int      @default(1)
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceNote   Note?    @relation("EventSource", fields: [sourceNoteId], references: [id], onDelete: SetNull)

  @@index([userId, startsAt, endsAt])
  @@map("calendar_events")
}

model ChangeLog {
  cursor     BigInt          @id @default(autoincrement())
  userId     String          @map("user_id") @db.Char(36)
  entityType EntityType      @map("entity_type")
  entityId   String          @map("entity_id") @db.Char(36)
  operation  ChangeOperation
  version    Int
  changedAt  DateTime        @default(now()) @map("changed_at")
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, cursor])
  @@map("change_log")
}

model Mutation {
  id             String   @id @default(uuid()) @db.Char(36)
  userId         String   @map("user_id") @db.Char(36)
  idempotencyKey String   @map("idempotency_key") @db.VarChar(191)
  response       Json
  createdAt      DateTime @default(now()) @map("created_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([createdAt])
  @@map("mutations")
}
