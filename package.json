{
  "name": "sticky-notes",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:generate": "pnpm --filter @sticky-notes/api prisma:generate",
    "db:migrate": "pnpm --filter @sticky-notes/api prisma:migrate",
    "db:studio": "pnpm --filter @sticky-notes/api prisma:studio"
  },
  "devDependencies": {
    "turbo": "2.10.4",
    "typescript": "5.9.3"
  }
}
